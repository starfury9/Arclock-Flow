# ── Arc network ──────────────────────────────────────────────
# Official Circle RPC endpoints (see https://docs.arc.io/arc/references/connect-to-arc)
ARC_MAINNET_RPC_URL=https://rpc.mainnet.arc.io
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io
ARC_MAINNET_CHAIN_ID=5042
ARC_TESTNET_CHAIN_ID=5042002

# USDC token address on Arc (same on mainnet & testnet)
ARC_USDC_ADDRESS=0x3600000000000000000000000000000000000000

# ── Deployment ───────────────────────────────────────────────
# Private key of the deployer wallet. NEVER commit a real value here.
DEPLOYER_PRIVATE_KEY=

# Filled in after deployment (scripts/deploy.ts writes these for you)
ARCLOCK_CONTRACT_ADDRESS_TESTNET=
ARCLOCK_CONTRACT_ADDRESS_MAINNET=

# ── Backend ──────────────────────────────────────────────────
PORT=4000
DATABASE_URL=file:./data/arclock.sqlite
# Which network the backend/indexer should watch: "testnet" | "mainnet"
ARC_NETWORK=testnet

# ── Frontend ─────────────────────────────────────────────────
NEXT_PUBLIC_ARC_NETWORK=testnet
NEXT_PUBLIC_ARCLOCK_CONTRACT_ADDRESS=
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
